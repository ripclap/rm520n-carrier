id "8a905840-07c1-4164-9c23-134aead2e4c1") (effects (font (size 1.27 1.27)))) (property "Description" "" (at 0 0 0) (layer "F.Fab") (hide yes) (uuid "0fbfeb9f-0322-42d4-b8ef-28049f88fd1d") (effects (font (size 1.27 1.27)))) (property "MPN" "H2414QR" (at 0 0 270) (layer "F.SilkS") (hide yes) (uuid "2fbeea47-aa38-41d2-8f40-d5352314a845") (effects (font (size 1.27 1.27) (thickness 0.15)))) (property "Manufacturer" "E-NETTR (Dongguan Xiangxing Electronics)" (at 0 0 270) (layer "F.SilkS") (hide yes) (uuid "5b63bed8-78ac-44b3-b6ee-614a2bc75e05") (effects (font (size 1.27 1.27) (thickness 0.15)))) (property "LCSC" "C4155001" (at 0 0 270) (layer "F.SilkS") (hide yes) (uuid "0e7a0b71-fd16-42fa-a8a5-af1e0e960e37") (effects (font (size 1.27 1.27) (thickness 0.15)))) (property "Note" "H2414QR engineering-prototype magnetics, primary rated 2.5/5G and 1A PoE capability over 0..70C. OCL180uH at 25C/100kHz/0.1V has no specified DC bias; DCR1ohm maximum has no winding-balance tolerance, and 1A injection/test conditions are absent. The defined installation uses regulated nonisolated 50.4V maximum and a 0..70C component environment. Normal input RMS and cable/CT temperature limits are governed by the final whole-board power policy and its waveform contract; the limited fault and impulse envelopes are separate, not continuous ratings. Retain loaded-link, DC imbalance/bias, ripple, temperature-rise and fault first-article verification. No IEEE PoE/system-isolation or arbitrary-imbalance OCL guarantee is inferred. Final F78.6,85/0 uses the primary 24-land pattern and both-side logical channel reversals, preserving all eight standard J1 pin polarities without a PHY register swap. All MDI/cable/CT branches are reconstructed, fully routed and covered by the final joined-revision source/reference receipts. Factory assembly/CAM and powered Ethernet/current characterization remain release conditions." (at 0 0 270) (layer "F.SilkS") (hide yes) (uuid "211c1334-5be2-4719-ac5d-8564f914e118") (effe