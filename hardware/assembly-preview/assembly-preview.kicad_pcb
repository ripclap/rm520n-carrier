824ee19b91b6") (effects (font (size 1.27 1.27) (thickness 0.15)))) (property "Note" "Additional local100nF50VX7R0402 downstream shunt at ESP32 voltage ADC entry. Existing upstream C760..C763 remain before U748. Same common SamsungCL05B104KB5NNNC; routed from the actual saved MCU entry via and GND must contact a literal J2-sourced plane. Max1.05x.55mm part plus independent100um assembly placement; ordinary bores kept outside pad/body. Filter settling, ADC mux discard/averaging/calibration/temperature and near-rail error require prototype firmware qualification. This capacitor does not prove voltage accuracy, physical modem rail discharge or reset OFF dwell. Mechanical/CAD footprint hold closed by exact frozen885 ADC898 receipt: maxbody1.05x0.55x0.55mm plus independent100umXY/finished-bore guards, literal cap1-to-U800/U748 and cap2-to-J2 source paths. Independently rebind and verify unchanged final native cap geometry before build release. All ADC noise/settling/calibration/temperature/near-rail and physicalOFF commissioning conditions remain." (at 0 0 0) (layer "F.SilkS") (hide yes) (uuid "0b34e6f9-48b2-41b8-96e3-5abdb67ac89d") (effects (font (size 1.27 1.27) (thickness 0.15)))) (path "/b78b40e8-3925-5223-8570-e55b94f093e5/0d24d849-d889-4b0e-8f0a-29a519b1dd36") (sheetname "/Protected 12 V bus and regulated low-voltage rails") (sheetfile "power-rails.kicad_sch") (attr smd) (duplicate_pad_numbers_are_jumpers no) (fp_line (start -0.107836 -0.36) (end 0.107836 -0.36) (stroke (width 0.12) (type solid)) (layer "F.SilkS") (uuid "e517e2e8-a58c-4aa9-a33a-4d372d382804")) (fp_line (start -0.107836 0.36) (end 0.107836 0.36) (stroke (width 0.12) (type solid)) (layer "F.SilkS") (uuid "4e245d14-c827-4db1-bea8-86a9e78024af")) (fp_rect (start -0.91 -0.46) (end 0.91 0.46) (stroke (width 0.05) (type solid)) (fill no) (layer "F.CrtYd") (uuid "20007663-264b-425e-a5dd-e67583b313db")) (fp_rect (start -0.5 -0.25) (end 0.5 0.25) (stroke (width 0.1) (type solid)) (fill no) (layer "F.Fab") (uu