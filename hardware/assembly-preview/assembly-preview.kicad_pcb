l 94uF converter bank and connected protected eFuse load still require measured first-article compensation/loop noise, startup, load-step, ripple, transient and fault characterization. A recommended feed-forward value alone does not establish stable-loop performance." (at 0 0 0) (layer "F.SilkS") (hide yes) (uuid "5d950f80-7761-4b0e-b733-ae7dd0025cdb") (effects (font (size 1.27 1.27) (thickness 0.15)))) (property "Manufacturer" "KEMET" (at 0 0 0) (layer "F.SilkS") (hide yes) (uuid "c22beb93-a92f-4009-b928-f5dc30ef5692") (effects (font (size 1.27 1.27) (thickness 0.15)))) (property "MPN" "C0402C330J5GACTU" (at 0 0 0) (layer "F.SilkS") (hide yes) (uuid "9a255a6b-6a7b-4c05-b3e5-82356bea95e8") (effects (font (size 1.27 1.27) (thickness 0.15)))) (path "/b78b40e8-3925-5223-8570-e55b94f093e5/d7eece2f-2c61-4c4b-a54e-5dd47574e079") (sheetname "/Protected 12 V bus and regulated low-voltage rails") (sheetfile "power-rails.kicad_sch") (attr smd) (duplicate_pad_numbers_are_jumpers no) (fp_line (start -0.107836 -0.36) (end 0.107836 -0.36) (stroke (width 0.12) (type solid)) (layer "F.SilkS") (uuid "9a330a04-9023-47c2-b7c4-64299f8eadca")) (fp_line (start -0.107836 0.36) (end 0.107836 0.36) (stroke (width 0.12) (type solid)) (layer "F.SilkS") (uuid "004bfe9f-46a8-4452-ae47-a5d2d136fccd")) (fp_rect (start -0.91 -0.46) (end 0.91 0.46) (stroke (width 0.05) (type solid)) (fill no) (layer "F.CrtYd") (uuid "9bb96d2a-8746-4c7f-8bd4-2a70991cffc4")) (fp_rect (start -0.5 -0.25) (end 0.5 0.25) (stroke (width 0.1) (type solid)) (fill no) (layer "F.Fab") (uuid "37becc18-8a0a-4f52-81b1-c3f7142e978d")) (fp_text user "${REFERENCE}" (at 0 0 0) (layer "F.Fab") (uuid "96ec52ed-e2fd-4706-82dc-1f3d0db02829") (effects (font (size 0.25 0.25) (thickness 0.04)))) (pad "1" smd roundrect (at -0.48 0) (size 0.56 0.62) (layers "F.Cu" "F.Mask" "F.Paste") (roundrect_rratio 0.25) (net "V3V7_REG") (pintype "passive") (uuid "03e488c2-19e0-4910-83c8-79b0099144c4")) (pad "2" smd roundrect (at 0.48 0) (size 0.56 0.62) 