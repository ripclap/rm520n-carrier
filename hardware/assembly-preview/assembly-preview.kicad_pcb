ickness 0.15)) (justify mirror))) (property "Datasheet" "https://www.ti.com/lit/ds/symlink/sn74lvc1g11.pdf" (at 0 0 270) (layer "B.Fab") (hide yes) (uuid "6f3ca670-7d87-492c-8978-6337e314ff44") (effects (font (size 1.27 1.27)) (justify mirror))) (property "Description" "" (at 0 0 270) (layer "B.Fab") (hide yes) (uuid "1cd3bd54-5630-4f21-baaf-a4bc728dce46") (effects (font (size 1.27 1.27)) (justify mirror))) (property "KiLib_Generator" "package/gullwing" (at 0 0 270) (layer "B.SilkS") (hide yes) (uuid "03936899-b7e1-4bcb-b74c-cb5169049e41") (effects (font (size 1 1) (thickness 0.15)) (justify mirror))) (property "LCSC" "" (at 0 0 0) (layer "B.SilkS") (hide yes) (uuid "e72de05b-ba83-4d49-ab81-fe6a808613e2") (effects (font (size 1.27 1.27) (thickness 0.15)))) (property "Note" "Hardware default-autostart remains POWER_OK & RUN. Former CURRENT_OK input3 is tied directly to this gate V3V3, not fault status; same authentic G11 DBV package. MODEM_EN_ALLOWED drives BOTH MP2386 EN11 and TPS259474LRPWR EN1. PG/FLT must not feed EN or cause automatic latch-clearing. RUN remains external pull-high with MCU open-drain inhibit; main-domain supply loss yields passive EN LOW. Any actual input/rail power loss can rearm the volatile eFuse latch; no AON-retained fault-memory claim. The new compact eFuse PG remains observation/start qualification only; it never drives EN. Blank/reset MCU leaves Q740 gate LOW via R741, so R752 pulls RUN HIGH and hardware starts the modem after main POWER_OK. U16 CT is hardware programmed by R118=100k to guarantee at least180ms protected PG/start qualification before FCPO release; independent OOB open-drain RUN inhibit and MR assertion retain hard-off recovery." (at 0 0 0) (layer "B.SilkS") (hide yes) (uuid "cf4d5c7c-bf63-474d-b45d-e49951959347") (effects (font (size 1.27 1.27) (thickness 0.15)))) (property "Manufacturer" "Texas Instruments" (at 0 0 0) (layer "B.SilkS") (hide yes) (uuid "c6956b7a-cbb9-49cb-9c49-0f4661e4a0b8") (effects (font (size 1.27 1.27) (thickness 0.15)))) (property "MPN" "SN74LVC1G11DBVR" (at 0 0 0) (layer "B.SilkS") (hide yes) (uuid "2a19fbb2-8d90-4b22-881d-2991800f3f27") (effects (font (size 1.27 1.27) (thickness 0.15)))) (path "/30fcecd2-9788-57fb-9cbc-6ada3d5363dd/b17981b5-5e41-407f-b3ad-1ca7662c8623") (sheetname "/Modem current ceiling and always-on supply") (sheetfile "class6-grants.kicad_sch") (attr smd) (duplicate_pad_numbers_are_jumpers no) (fp_line (start 0.91 -1.56) (end -0.91 -1.56) (stroke (width 0.12) (type solid)) (layer "B.SilkS") (uuid "324b548a-1fe5-41fb-aba5-497626e50010")) (fp_line (start -0.91 -1.56) (end -0.91 -1.51) (stroke (width 0.12) (type solid)) (layer "B.SilkS") (uuid "9efa1f5b-33a4-4814-8f85-708fe32b931b")) (fp_line (start 0.91 -1.51) (end 0.91 -1.56) (stroke (width 0.12) (type solid)) (layer "B.SilkS") (uuid "da87750f-b6d5-4510-a746-27521b94083c")) (fp_line (start -0.91 1.51) (end -0.91 1.56) (stroke (width 0.12) (type solid)) (layer "B.SilkS") (uuid "3841a14c-c128-4b6f-a9bd-10b09ab1ddd0")) (fp_line (start 0.91 1.56) (end 0.91 1.51) (stroke (width 0.12) (type solid)) (layer "B.SilkS") (uuid "1844b570-9332-48b2-8370-0f52a4fa617b")) (fp_line (start -0.91 1.56) (end 0.91 1.56) (stroke (width 0.12) (type solid)) (layer "B.SilkS") (uuid "9e49a7cc-bb82-4fc3-a623-36db69f238ca")) (fp_poly (pts (xy -1.45 1.51) (xy -1.69 1.84) (xy -1.21 1.84)) (stroke (width 0.12) (type solid)) (fill yes) (layer "B.SilkS") (uuid "1c2a73c0-ac39-4e6c-9310-048cc2d4b7e4")) (fp_line (start 1.05 -1.7) (end -1.05 -1.7) (stroke (width 0.05) (type solid)) (layer "B.CrtYd") (uuid "9766cd00-6998-4725-8926-c2ff4abaa2e3")) (fp_line (start -1.05 -1.7) (end -1.05 -1.5) (stroke (width 0.05) (type solid)) (layer "B.CrtYd") (uuid "ba4413ff-115f-4da6-a4a1-e6065b9b5bf6")) (fp_line (start 2.05 -1.5) (end 1.05 -1.5) (stroke (width 0.05) (type solid)) (layer "B.CrtYd") (uuid "fb037f0b-cbcb-498e-8f35-58b6de6f44ec")) (fp_line (start 1.05 -1.5) (end 1.05 -1.7) (stroke (width 0.05) (type solid)) (layer "B.CrtYd") (uu