33.45. Maximum Vishay body1.05x0.55mm plus independent100um XY and every actual finished bore/F-B land/double-hole are independently checked before admission. Series22ohm is a first-prototype edge damping provision, no claimed matched impedance. Configure lowest suitable MCU drive and initial1MHzSPI; measure loaded clock edges/overshoot/undershoot/timing at both endpoints. HardwareOE and independent modem/radio recovery remain unchanged." (at 0 0 90) (layer "F.SilkS") (hide yes) (uuid "d0671763-8978-5f32-b06d-22d26a431a00") (effects (font (size 1.27 1.27) (thickness 0.15)))) (path "/b78b40e8-3925-5223-8570-e55b94f093e5/ab113726-648b-41b0-b837-5636888233f9") (sheetname "/Protected 12 V bus and regulated low-voltage rails") (sheetfile "power-rails.kicad_sch") (attr smd) (duplicate_pad_numbers_are_jumpers no) (fp_line (start -0.153641 0.38) (end 0.153641 0.38) (stroke (width 0.12) (type solid)) (layer "F.SilkS") (uuid "d4434cd1-a2b0-5710-908c-957a2d140e93")) (fp_line (start -0.153641 -0.38) (end 0.153641 -0.38) (stroke (width 0.12) (type solid)) (layer "F.SilkS") (uuid "0013ab7e-ccd6-5b90-b32d-96a1321a26f6")) (fp_rect (start -0.93 -0.47) (end 0.93 0.47) (stroke (width 0.05) (type solid)) (fill no) (layer "F.CrtYd") (uuid "2796a1f4-a5d3-536d-9e62-f0c8c959bb4f")) (fp_rect (start -0.525 -0.27) (end 0.525 0.27) (stroke (width 0.1) (type solid)) (fill no) (layer "F.Fab") (uuid "d4b96461-4d8c-5763-9b29-a66793c66687")) (fp_text user "${REFERENCE}" (at 0 0 180) (layer "F.Fab") (uuid "ec0adc8c-a880-54e6-ad03-e18a2a181575") (effects (font (size 0.26 0.26) (thickness 0.04)))) (pad "1" smd roundrect (at -0.51 0 180) (size 0.54 0.64) (layers "F.Cu" "F.Mask" "F.Paste") (roundrect_rratio 0.25) (net "OOB_RADIO_SCK_MCU_DRV") (pinfunction "1") (pintype "passive") (uuid "a8f29a03-f8d2-56cc-be8f-4917318fa9a6")) (pad "2" smd roundrect (at 0.51 0 180) (size 0.54 0.64) (layers "F.Cu" "F.Mask" "F.Paste") (roundrect_rratio 0.25) (net "OOB_RADIO_SCK_MCU") (pinfunction "2") (pintype "passive") (