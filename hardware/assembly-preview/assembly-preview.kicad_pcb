 and assembled validation." (at 0 0 0) (layer "F.SilkS") (hide yes) (uuid "e817e865-1798-4b73-ad61-67f99de270bf") (effects (font (size 1.27 1.27) (thickness 0.15)))) (property "Manufacturer" "ATTEND Technology" (at 0 0 0) (layer "F.SilkS") (hide yes) (uuid "db2eaf1a-e183-4abd-a852-665f4cf46454") (effects (font (size 1.27 1.27) (thickness 0.15)))) (property "MPN" "123A-42B02" (at 0 0 0) (layer "F.SilkS") (hide yes) (uuid "73995138-a53b-4907-a8ef-9c21f923ab19") (effects (font (size 1.27 1.27) (thickness 0.15)))) (path "/f887535a-a945-5cc0-9489-1072ba674005/a20aec45-245c-4f27-a0f3-c8107c714966") (sheetname "/RM520N-GL primary / RM551E-GL compatible M.2 socket, SIM 1, eUICC (SIM 2), USB-C") (sheetfile "modem-interfaces.kicad_sch") (attr smd) (duplicate_pad_numbers_are_jumpers yes) (fp_line (start -11.17 -4.55) (end -11.17 4.55) (stroke (width 0.12) (type default)) (layer "F.SilkS") (uuid "bf5b3645-5aec-47a7-9494-22e4f8505e41")) (fp_line (start 11.17 -4.55) (end 11.17 4.55) (stroke (width 0.12) (type default)) (layer "F.SilkS") (uuid "47b447b1-1f13-4e5b-bf62-c3f5ef6c5705")) (fp_line (start -11.5 -5.05) (end 11.5 -5.05) (stroke (width 0.05) (type default)) (layer "F.CrtYd") (uuid "7a77fc22-1b80-4a73-98a5-d13a79de3f24")) (fp_line (start -11.5 5.05) (end -11.5 -5.05) (stroke (width 0.05) (type default)) (layer "F.CrtYd") (uuid "038f2c2c-0910-45cb-ab39-b5c727ab7a69")) (fp_line (start 11.5 -5.05) (end 11.5 5.05) (stroke (width 0.05) (type default)) (layer "F.CrtYd") (uuid "20ea29c3-8108-4b14-8445-b714f6dd419a")) (fp_line (start 11.5 5.05) (end -11.5 5.05) (stroke (width 0.05) (type default)) (layer "F.CrtYd") (uuid "b190cb7b-d4b0-4215-8c09-62d95c99066d")) (fp_line (start -11 -4.55) (end 11 -4.55) (stroke (width 0.1) (type default)) (layer "F.Fab") (uuid "45765e9a-4eb1-4e10-99d6-e4aa3b427b4a")) (fp_line (start -11 4.55) (end -11 -4.55) (stroke (width 0.1) (type default)) (layer "F.Fab") (uuid "3c847636-1046-441b-ba1f-cd6409593b1a")) (fp_line (start 4.25 -4.55) (end 6.75 -4.55)