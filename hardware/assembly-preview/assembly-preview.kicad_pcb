 intentionally removed; actual rail may ride healthy handoff. First prototype captures startup/crossover/dropout/noise and actual assembled thresholds." (at 0 0 0) (layer "F.SilkS") (hide yes) (uuid "61921131-fcd1-4f5c-acab-6f30a29f766b") (effects (font (size 1.27 1.27) (thickness 0.15)))) (path "/b78b40e8-3925-5223-8570-e55b94f093e5/36918f41-36b2-4c0f-9e65-09e6407d50dd") (sheetname "/Protected 12 V bus and regulated low-voltage rails") (sheetfile "power-rails.kicad_sch") (attr smd) (duplicate_pad_numbers_are_jumpers no) (fp_rect (start -1.2 -1.05) (end 1.2 1.05) (stroke (width 0.05) (type default)) (fill no) (layer "F.CrtYd") (uuid "92215587-30bc-4145-ad12-e6d8a1f0ff6c")) (fp_line (start -0.775 -0.55) (end -0.55 -0.775) (stroke (width 0.1) (type default)) (layer "F.Fab") (uuid "a2178f6f-5cde-4089-87fa-4684d0e2bdc8")) (fp_rect (start -0.775 -0.775) (end 0.775 0.775) (stroke (width 0.1) (type default)) (fill no) (layer "F.Fab") (uuid "98b4b071-8443-4d98-a5c9-83586f376b47")) (pad "1" smd roundrect (at -0.55 -0.5) (size 0.8 0.25) (layers "F.Cu" "F.Mask" "F.Paste") (roundrect_rratio 0.2) (net "MAIN_SUPERVISOR_SENSE") (pinfunction "SENSE") (pintype "input") (solder_mask_margin -0.05) (uuid "43cd632c-3308-5996-8892-84e1dfc96ee4")) (pad "2" smd roundrect (at -0.6 0) (size 0.7 0.25) (layers "F.Cu" "F.Mask" "F.Paste") (roundrect_rratio 0.2) (net "GND") (pinfunction "GND") (pintype "power_in") (solder_mask_margin -0.05) (uuid "97bfccb4-ff1a-5b98-86c6-8e79aeddc9ad")) (pad "3" smd roundrect (at -0.6 0.5) (size 0.7 0.25) (layers "F.Cu" "F.Mask" "F.Paste") (roundrect_rratio 0.2) (net "V3V3") (pinfunction "MR_N") (pintype "input") (solder_mask_margin -0.05) (uuid "0f25ec97-3c28-5381-ab14-7bb66ac093ed")) (pad "4" smd roundrect (at 0.6 0.5) (size 0.7 0.25) (layers "F.Cu" "F.Mask" "F.Paste") (roundrect_rratio 0.2) (net "V3V3") (pinfunction "VDD") (pintype "power_in") (solder_mask_margin 0.05) (uuid "de3ba868-5812-5c0d-a4c9-6218b05f4b18")) (pad "5" smd roundrect (at 0.6 0) (size 0.7 0