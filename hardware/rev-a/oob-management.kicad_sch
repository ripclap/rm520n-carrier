 bus capacitance." (id 5) (at 497.84000000000003 223.52 0) (effects (font (size 1.27 1.27)) (justify left) hide)) (property "Manufacturer" "Nexperia" (id 6) (at 497.84000000000003 223.52 0) (effects (font (size 1.27 1.27)) (justify left) hide)) (property "MPN" "NCA9536DQJ" (id 7) (at 497.84000000000003 223.52 0) (effects (font (size 1.27 1.27)) (justify left) hide)) (pin "1" (uuid 0b93e193-a4ba-4f2c-87f1-a26cefc26249)) (pin "2" (uuid 070083ba-af15-4d96-87fd-be68cf9b21ad)) (pin "3" (uuid f3bf885a-5801-4824-b9ab-de0b7f0ea5da)) (pin "5" (uuid 86454ce8-a38c-4bf4-add7-6fcb7009d274)) (pin "6" (uuid 8819af50-eb12-4599-b480-16746b51e096)) (pin "7" (uuid 3a1b1551-e8e4-4c69-b2dd-5efe3631e25c)) (pin "8" (uuid a720961a-d9b0-4652-b350-030b2a40efbc)) (pin "4" (uuid c38492a6-70ec-4185-ad93-dbd96699c0a2)) (instances (project "carrier" (path "/9f463650-1ded-435e-96c4-5fb413d72b62/229935cf-90b2-58d3-a14f-c3f095b25ed6" (reference "U840") (unit 1))))) (sheet_instances (path "/9f463650-1ded-435e-96c4-5fb413d72b62/229935cf-90b2-58d3-a14f-c3f095b25ed6" (page "9"))))
