-independent. Native/source/GND/reference/process/capacitance proof pending." (at 0 0 -90) (layer "F.SilkS") (hide yes) (uuid "7ab94af3-cb04-4624-8e7f-bf013be1708d") (effects (font (size 1.27 1.27) (thickness 0.15)) (justify mirror))) (property "LCSC" "" (at 0 0 -90) (layer "F.SilkS") (hide yes) (uuid "b7991c86-600f-4120-89cc-2637fb97b7b4") (effects (font (size 1.27 1.27) (thickness 0.15)) (justify mirror))) (attr smd) (duplicate_pad_numbers_are_jumpers no) (fp_line (start -1.25 -1.25) (end -1.25 1.25) (stroke (width 0.1) (type solid)) (layer "F.SilkS") (uuid "c4f27023-eecc-545a-8e4b-64adb953862d")) (fp_line (start -1.25 1.25) (end 1.25 1.25) (stroke (width 0.1) (type solid)) (layer "F.SilkS") (uuid "150a087d-2a58-5c6f-9e1b-f49f7b6d20f9")) (fp_line (start 1.25 -1.25) (end -1.25 -1.25) (stroke (width 0.1) (type solid)) (layer "F.SilkS") (uuid "0bb080e6-5b21-56de-b841-5b4cf1cbb4d4")) (fp_line (start 1.25 1.25) (end 1.25 -1.25) (stroke (width 0.1) (type solid)) (layer "F.SilkS") (uuid "cd3c33d5-87a0-510c-956d-eee60f40ba33")) (fp_line (start -2.85 -1.3) (end -1.75 -1.3) (stroke (width 0.05) (type solid)) (layer "F.CrtYd") (uuid "20b8ac10-497c-51e5-9ebd-032db3d5b8d3")) (fp_line (start -2.85 -0.65) (end -2.85 -1.3) (stroke (width 0.05) (type solid)) (layer "F.CrtYd") (uuid "46e4206d-4ade-54a0-87fa-eb3bb365fa5f")) (fp_line (start -2.85 0) (end -2.85 -0.65) (stroke (width 0.05) (type solid)) (layer "F.CrtYd") (uuid "45efc0b3-81fb-5c5a-9925-ad8df2c9c74d")) (fp_line (start -2.85 0.65) (end -2.85 0) (stroke (width 0.05) (type solid)) (layer "F.CrtYd") (uuid "259cb3ea-8b3e-50a9-b31b-4ceb4d2276d3")) (fp_line (start -2.85 1.3) (end -2.85 0.65) (stroke (width 0.05) (type solid)) (layer "F.CrtYd") (uuid "92f6666d-1bd8-5274-94b9-81fc2b8d6981")) (fp_line (start -1.75 -1.85) (end 1.75 -1.85) (stroke (width 0.05) (type solid)) (layer "F.CrtYd") (uuid "79243842-d0e4-5100-beea-2b82a259fabf")) (fp_line (start -1.75 -1.3) (end -1.75 -1.85) (stroke (width 0.05) (type solid)) (layer "F.CrtYd