(version 1)
# Generated physical constraints; do not silence release blockers.
(rule "Rev A reference and critical signal layers"
  (condition "(A.Type == 'Track' && (((A.Layer == 'In1.Cu' || A.Layer == 'In4.Cu') && A.NetName != 'GND' && A.NetName != 'CABLE_PWR_N') || ((A.Layer == 'In2.Cu' || A.Layer == 'In3.Cu') && (A.NetClass == 'PCIE_85' || A.NetClass == 'CLK_85' || A.NetClass == 'USB_90' || A.NetClass == 'MDI_100' || (A.NetClass == 'CABLE100' && !(((A.NetName == 'CABLE0_P' || A.NetName == 'CABLE0_N') && A.Layer == 'In3.Cu' && (A.memberOfGroup('build_rev_a_CABLE48_inner') || A.memberOfGroup('build_rev_a_CABLE48_J1_terminals'))) || ((A.NetName == 'CABLE1_P' || A.NetName == 'CABLE1_N') && A.Layer == 'In2.Cu' && (A.memberOfGroup('build_rev_a_CABLE48_inner') || A.memberOfGroup('build_rev_a_CABLE48_J1_terminals'))) || ((A.NetName == 'CABLE2_P' || A.NetName == 'CABLE2_N') && A.Layer == 'In3.Cu' && (A.memberOfGroup('build_rev_a_CABLE48_inner') || A.memberOfGroup('build_rev_a_CABLE48_J1_terminals'))) || ((A.NetName == 'CABLE3_P' || A.NetName == 'CABLE3_N') && A.Layer == 'In2.Cu' && (A.memberOfGroup('build_rev_a_CABLE48_inner') || A.memberOfGroup('build_rev_a_CABLE48_J1_terminals'))))) || A.NetClass == 'OOB_RF_50' || A.NetName == 'BUCK_SW' || A.NetName == 'BUCK_HO' || A.NetName == 'BUCK_LO' || A.NetName == 'BUCK_BOOT_RC' || A.NetName == 'BUCK_BST' || A.NetName == 'u3_SW' || A.NetName == 'u3_BST' || A.NetName == 'u4_SW' || A.NetName == 'u5_SW' || A.NetName == 'OOB_SW')))) && !(A.Type == 'Track' && A.Layer == 'In2.Cu' && A.NetName == 'u3_BST' && A.memberOfGroup('rev_a_MP2386_B52_BST_inner_v1')) && !(A.Type == 'Track' && A.Layer == 'In4.Cu' && A.NetName == 'RTL_EEDI' && A.memberOfGroup('rev_a_EEDI_CORE_plane227_exact10_In4')) && !(A.Type == 'Track' && A.Layer == 'In4.Cu' && A.NetName == 'UIM2_CLK' && A.memberOfGroup('root_SIM_CLK456')) && !(A.Type == 'Track' && A.Layer == 'In4.Cu' && A.NetName == 'UIM1_DATA' && A.memberOfGroup('root_SIM_DATA424')) && !(A.Type == 'Track' && A.Layer == 'In4.Cu' && A.NetName == 'UIM2_VDD' && A.memberOfGroup('root_SIM_VDDpullup498')) && !(A.Type == 'Track' && A.Layer == 'In4.Cu' && A.NetName == 'UIM2_RST' && A.memberOfGroup('root_SIM_compact480'))")
  (constraint disallow track)
)
(rule "PCIE_85 geometry"
  (condition "A.NetClass == 'PCIE_85'")
  (constraint track_width (min 0.149000mm) (opt 0.154000mm) (max 0.159000mm))
  (constraint diff_pair_gap (min 0.145000mm) (opt 0.150000mm) (max 0.155000mm))
  (constraint diff_pair_uncoupled (max 2.000000mm))
)
(rule "PCIE_85 noncoplanar lateral copper"
  (condition "A.NetClass == 'PCIE_85' && A.Type == 'Track' && !AB.isCoupledDiffPair() && B.Type != 'Pad'")
  (constraint clearance (min 0.462000mm))
)
(rule "CLK_85 geometry"
  (condition "A.NetClass == 'CLK_85'")
  (constraint track_width (min 0.149000mm) (opt 0.154000mm) (max 0.159000mm))
  (constraint diff_pair_gap (min 0.145000mm) (opt 0.150000mm) (max 0.155000mm))
  (constraint diff_pair_uncoupled (max 2.000000mm))
)
(rule "CLK_85 noncoplanar lateral copper"
  (condition "A.NetClass == 'CLK_85' && A.Type == 'Track' && !AB.isCoupledDiffPair() && B.Type != 'Pad'")
  (constraint clearance (min 0.462000mm))
)

(rule "USB_90 geometry"
