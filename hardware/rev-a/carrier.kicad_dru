  (constraint track_width (min 0.131000mm) (opt 0.136000mm) (max 0.141000mm))
  (constraint diff_pair_gap (min 0.145000mm) (opt 0.150000mm) (max 0.155000mm))
  (constraint diff_pair_uncoupled (max 2.000000mm))
)
